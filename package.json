{
  "name": "simple-thermostat-card",
  "version": "3.11.0",
  "description": "A Lovelace thermostat card for Home Assistant",
  "main": "dist/simple-thermostat.js",
  "type": "module",
  "repository": "git@github.com:Ava-AgentOne/simple-thermostat-card.git",
  "author": "Ava-AgentOne",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "debounce-fn": "6.0.0",
    "lit": "3.3.3",
    "squirrelly": "8.0.8"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "28.0.9",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.3.0",
    "@size-limit/file": "11.2.0",
    "@size-limit/time": "11.2.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.1",
    "concurrently": "9.2.3",
    "cross-env": "7.0.3",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss": "8.5.16",
    "postcss-preset-env": "10.6.1",
    "prettier": "3.9.4",
    "pretty-quick": "4.2.2",
    "rollup": "4.62.2",
    "rollup-plugin-dts": "6.4.1",
    "rollup-plugin-inject-process-env": "1.3.1",
    "rollup-plugin-postcss": "4.0.2",
    "rollup-plugin-postcss-lit": "2.2.0",
    "size-limit": "11.2.0",
    "ts-jest": "29.4.11",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "jest",
    "build": "cross-env NODE_ENV=production rollup -c",
    "postversion": "npm run build",
    "dev": "concurrently 'npm:dev:*'",
    "dev:build": "tsc --watch",
    "dev:test": "jest --watchAll",
    "size-build": "yarn build",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "size-limit": [
    {
      "path": "dist/simple-thermostat.js",
      "limit": "20 KB"
    }
  ]
}
